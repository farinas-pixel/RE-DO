# Supabase Configuration (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Voice / Transcription API (Optional Speech-to-Text via AssemblyAI)
# Never expose provider API keys with VITE_ prefix if used on client.
# Keep server-side or secure proxy.
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# Google OAuth (Optional - enable in Supabase Dashboard > Auth > Providers)
